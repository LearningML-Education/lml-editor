{
  "$schema": "https://raw.githubusercontent.com/lit/lit/main/packages/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": [
    "es",
    "ca",
    "gl",
    "eu",
    "it",
    "de",
    "el",
    "pt",
    "nl",
    "fr"
  ],
  "inputFiles": [
    "src/**/*.js"
  ],
  "output": {
    "mode": "runtime",
    "outputDir": "./src/i18n",
    "localeCodesModule": "./src/components/main-menu/locale-codes.js"
  },
  "interchange": {
    "format": "xliff",
    "xliffDir": "./xliff/"
  }
}